{
  "name": "densi-assist",
  "private": true,
  "version": "0.3.0",
  "description": "Web-based densitometry for gel and western blot band quantification (runs entirely in the browser)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && npm run build:standalone",
    "build:standalone": "vite build --mode standalone",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
